# --- Database ---
# Laragon defaults: root with no password on 127.0.0.1:3306.
MWALIMU_DB_HOST=127.0.0.1
MWALIMU_DB_PORT=3306
MWALIMU_DB_NAME=mwalimu_plus
MWALIMU_DB_USER=root
MWALIMU_DB_PASS=

# --- Mail ---
# Mailtrap sandbox by default; swap these when moving to production SMTP.
MAIL_FROM_NAME=MwalimuPlus
MAIL_FROM_ADDRESS=no-reply@mwalimuplus.ai
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

CLAUDE_API_KEY=

# --- AI Providers ---
# Each provider becomes selectable in Settings > AI only when its key is filled in.
# Keys are read from this file at runtime; they are never stored in the database.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Wasender (WhatsApp) ---
# Use the SESSION API KEY from your Wasender dashboard (Session Management,
# shown after the WhatsApp session connects). Sending only works with that
# session key, NOT the account-level Personal Access Token.
WASENDER_API_KEY=
